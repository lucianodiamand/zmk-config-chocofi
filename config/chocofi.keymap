#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#define _NAV 1
#define _NUM 2
#define _SYM 3
#define _MED 4
#define _FUN 5
#define _MOU 6

&lt {
    bindings = <&mo>, <&ck>;
    quick-tap-ms = <200>;
};

&mt {
    bindings = <&kp>, <&ck>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";
        upper_snake { timeout-ms = <50>; key-positions = <4 5>; layers = <0>; bindings = <&cm 1>; };
        lower_snake { timeout-ms = <50>; key-positions = <14 15>; layers = <0>; bindings = <&cm 2>; };
        pascal { timeout-ms = <50>; key-positions = <4 15>; layers = <0>; bindings = <&cm 3>; };
        camel { timeout-ms = <50>; key-positions = <14 5>; layers = <0>; bindings = <&cm 4>; };
    };
    macros {
        uc_a_lower: uc_a_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_e &ux_n1 &ux_enter>;
        };
        uc_a_upper: uc_a_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_c &ux_n1 &ux_enter>;
        };
        double_a: double_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck A &ck A>;
        };
        uc_e_lower: uc_e_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_e &ux_n9 &ux_enter>;
        };
        uc_e_upper: uc_e_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_c &ux_n9 &ux_enter>;
        };
        double_e: double_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck E &ck E>;
        };
        uc_i_lower: uc_i_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_e &ux_d &ux_enter>;
        };
        uc_i_upper: uc_i_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_c &ux_d &ux_enter>;
        };
        double_i: double_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck I &ck I>;
        };
        uc_o_lower: uc_o_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_f &ux_n3 &ux_enter>;
        };
        uc_o_upper: uc_o_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_d &ux_n3 &ux_enter>;
        };
        double_o: double_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck O &ck O>;
        };
        uc_u_lower: uc_u_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_f &ux_a &ux_enter>;
        };
        uc_u_upper: uc_u_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_d &ux_a &ux_enter>;
        };
        double_u: double_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck U &ck U>;
        };
        uc_n_lower: uc_n_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_f &ux_n1 &ux_enter>;
        };
        uc_n_upper: uc_n_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LC(LS(U)) &ux_n0 &ux_n0 &ux_d &ux_n1 &ux_enter>;
        };
        double_n: double_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&ck N &ck N>;
        };
    };
    behaviors {
        ck: case_key { compatible = "custom,case-key"; #binding-cells = <1>; };
        cm: case_mode { compatible = "custom,case-mode"; #binding-cells = <1>; };
        dashboard_sync: dsync {
            compatible = "custom,dashboard-sync";
            #binding-cells = <2>;
        };
        ux_n0: unicode_n0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N0>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_n1: unicode_n1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp N1>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_n3: unicode_n3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp N3>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_n9: unicode_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N9>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_a: unicode_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp A>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_b: unicode_b {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp B>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_c: unicode_c {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C>, <&kp C>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_d: unicode_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp D>, <&kp D>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_e: unicode_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp E>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_f: unicode_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp F>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ux_enter: unicode_enter {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ENTER>, <&kp ENTER>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        accent_a: accent_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_a_lower>, <&uc_a_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        a_key: a_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <10>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&td_a>;
        };
        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck A>, <&double_a>, <&accent_a>;
        };
        accent_e: accent_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_e_lower>, <&uc_e_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        td_e: tap_dance_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck E>, <&double_e>, <&accent_e>;
        };
        accent_i: accent_i {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_i_lower>, <&uc_i_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        td_i: tap_dance_i {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck I>, <&double_i>, <&accent_i>;
        };
        accent_o: accent_o {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_o_lower>, <&uc_o_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        td_o: tap_dance_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck O>, <&double_o>, <&accent_o>;
        };
        accent_u: accent_u {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_u_lower>, <&uc_u_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        td_u: tap_dance_u {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck U>, <&double_u>, <&accent_u>;
        };
        accent_n: accent_n {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_n_lower>, <&uc_n_upper>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        td_n: tap_dance_n {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ck N>, <&double_n>, <&accent_n>;
        };
    };
};

/ {
        chosen { zmk,physical-layout = &foostan_corne_5col_layout; };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
//            | ESC | SPACE | TAB |  | ENT | BSPC | DEL |
                        bindings = <
   &ck Q &ck W &td_e &ck R &ck T   &ck Y &td_u  &td_i     &td_o   &ck P
   &a_key LGUI 0 &mt LALT S &mt LCTRL D &mt LSHFT F &ck G   &ck H &mt RSHFT J &mt RCTRL K &mt RALT L &mt RGUI SEMI
   &ck Z &ck X &ck C &ck V &ck B   &td_n &ck M  &kp COMMA &kp DOT &kp FSLH
       &lt _MED ESC &lt _NAV SPACE &lt _MOU TAB  &lt _SYM RET &lt _NUM BSPC &lt _FUN DEL
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------
// |     |     |     |     |     |   |     |     |     |     |     |
// |LGUI |LALT |LCTRL|LSHFT|     |   | LFT | DWN |  UP | RGT |     |
// |     |     |     |     |     |   |HOME |PG_DN|PG_UP| END | INS |
//             |     |_____|     |   | ENT |     |     |
                        bindings = <
&none    &none    &none     &none     &none  &none     &none     &none     &none     &none
&kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &none
&none    &none    &none     &none     &none  &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS
                         &none &trans &none  &ck ENTER &none     &none
                        >;
                };

                num_layer {
// -----------------------------------------------------------------
// |  [  |  7  |  8  |  9  |  ]  |   |     |     |     |     |     |
// |  ;  |  4  |  5  |  6  |  =  |   |     |RSHFT|RCTRL|RALT |RGUI |
// |  `  |  1  |  2  |  3  |  \  |   |     |     |     |     |     |
//             |  '  |  0  |  -  |   |     |     |_____|     |
                        bindings = <
&kp LBKT  &kp N7 &kp N8 &kp N9 &kp RBKT      &none &none     &none     &none    &none
&kp SCLN  &kp N4 &kp N5 &kp N6 &kp EQUAL     &none &kp RSHFT &kp RCTRL &kp RALT &kp RGUI
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp BSLH      &none &none     &none     &none    &none
                &kp SQT &kp N0 &kp MINUS     &none &trans &none
                        >;
                };

                sym_layer {
// -----------------------------------------------------------------
// |  {  |  &  |  *  |  (  |  }  |   |     |     |     |     |     |
// |  :  |  $  |  %  |  ^  |  +  |   |     |RSHFT|RCTRL|RALT |RGUI |
// |  ~  |  !  |  @  |  #  |  |  |   |     |     |     |     |     |
//             |  (  |  )  |  _  |   |     |_____|     |     |
                        bindings = <
&kp LBRC  &kp AMPS &kp ASTRK &kp LPAR  &kp RBRC  &none  &none     &none     &none    &none
&kp COLON &kp DLLR &kp PRCNT &kp CARET &kp PLUS  &none  &kp RSHFT &kp RCTRL &kp RALT &kp RGUI
&kp TILDE &kp EXCL &kp AT    &kp HASH  &kp PIPE &none  &none     &none     &none    &none
                   &kp LPAR  &kp RPAR  &kp UNDER &trans &none     &none
                        >;
                };

                media_layer {
// -----------------------------------------------------------------
// |     |     |     |     |     |   |     |     |     |     |     |
// |LGUI |LALT |LCTRL|LSHFT|     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
//             |_____|     |     |   |     |     |     |  
                        bindings = <
&none &none &none &none &none                  &none &none &none &none &bootloader
&kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none    &none &none &none &none &sys_reset
&none &none &none &none &none                  &none &none &none &none &none
           &trans &none &none     &none &none &none
                       >;
                };

                fun_layer {
// -----------------------------------------------------------------
// | F12 |  F7 |  F8 |  F9 | PSCN|   |     |     |     |     |     |
// | F11 |  F4 |  F5 |  F6 | SCLO|   |     |RSHFT|RCTRL|RALT |RGUI |
// | F10 |  F1 |  F2 |  F3 | PAUS|   |     |     |     |     |     |
//             |  APP| SPC | TAB |   |     |_____|     |     |
                        bindings = <
&kp F12 &kp F7 &kp F8 &kp F9 &kp PSCRN        &none &none &none  &none &none
&kp F11 &kp F4 &kp F5 &kp F6 &kp SLCK         &none &kp RSHFT &kp RCTRL &kp RALT &kp RGUI
&kp F10 &kp F1 &kp F2 &kp F3 &kp PAUSE_BREAK  &none &none &none  &none &none
         &kp K_APP &ck SPACE &ck TAB          &none &none &trans
                       >;
                };

                mouse_layer {
// -----------------------------------------------------------------
// |     |     |     |     |     |   |     |     |     |     |     |
// |LGUI |LALT |LCTRL|LSHFT|     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
//             |     |     |_____|   |     |     |     |
                        bindings = <
&none &none &none &none &none                  &none &none &none &none &none
&kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none
&none &none &none &none &none                  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none
           &none &none &trans     &mkp LCLK &mkp RCLK &mkp MCLK
                       >;
                };
        };
};

